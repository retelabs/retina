# Copy to docker/.env.prod and fill in the real values. Never commit real
# values, in this .example file or in .env.prod.
# scripts/gen-secrets.sh generates KERNEL_API_KEY/QUERY_API_KEY/CLICKHOUSE_PASSWORD.

# Public domains: DNS must point at the VPS's IP before the first start
# (otherwise the Let's Encrypt challenge fails). See
# docs/interfaces/caddy-reverse-proxy.md.
API_HOST=api.example.com
OTLP_HOST=otlp.example.com

# ACME contact email (certificate expiry, no other use).
ACME_EMAIL=

# ClickHouse: never reuse the dev-* values of docker-compose.stack.yml.
CLICKHOUSE_USER=retina
CLICKHOUSE_PASSWORD=

# Real API tokens (docs/interfaces/kernel-auth.md), never the
# dev-kernel-key/dev-query-key values of docker-compose.stack.yml.
KERNEL_API_KEY=
QUERY_API_KEY=

# Optional: extra tokens (comma-separated), one per external client on top
# of the primary token above, each revocable on its own. E.g.:
# KERNEL_API_KEYS_EXTRA=second-client-token
KERNEL_API_KEYS_EXTRA=
QUERY_API_KEYS_EXTRA=

# Optional: the subset of plugins to enable (see CLAUDE.md, plugin
# activation by config). Unset = every native plugin.
ENABLED_PLUGINS=
