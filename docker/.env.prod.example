# Copiez en docker/.env.prod et remplissez les vraies valeurs — jamais ce
# fichier .example ni .env.prod lui-même ne doivent être commités.
# scripts/gen-secrets.sh génère KERNEL_API_KEY/QUERY_API_KEY/CLICKHOUSE_PASSWORD.

# Domaines publics — DNS déjà pointé vers l'IP du VPS avant le premier
# démarrage (sinon le challenge Let's Encrypt échoue). Voir
# docs/interfaces/caddy-reverse-proxy.md.
API_HOST=api.example.com
OTLP_HOST=otlp.example.com

# Email de contact ACME (expiration de certificat, pas d'autre usage).
ACME_EMAIL=

# ClickHouse — ne jamais réutiliser les valeurs dev-* de docker-compose.stack.yml.
CLICKHOUSE_USER=venice
CLICKHOUSE_PASSWORD=

# Jetons d'API réels (docs/interfaces/kernel-auth.md) — jamais les valeurs
# dev-kernel-key/dev-query-key de docker-compose.stack.yml.
KERNEL_API_KEY=
QUERY_API_KEY=

# Optionnel : sous-ensemble de plugins actifs (voir CLAUDE.md,
# "Activation des plugins par config"). Vide = tous les plugins natifs.
ENABLED_PLUGINS=
