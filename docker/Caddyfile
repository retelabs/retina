# TLS reverse proxy in front of kernel (gRPC/OTLP) and query-api (HTTP);
# contract checked in docs/interfaces/caddy-reverse-proxy.md before writing
# this file. Automatic HTTPS (Let's Encrypt) is triggered by the mere presence
# of a domain name as a block address: nothing else to do.
{
	email {$ACME_EMAIL}
}

{$OTLP_HOST} {
	# tonic serves cleartext gRPC (TLS ends here, not in the kernel):
	# h2c:// is required, otherwise Caddy would talk HTTP/1.1 upstream and
	# break gRPC (which requires HTTP/2).
	reverse_proxy h2c://kernel:4317
}

{$API_HOST} {
	reverse_proxy query-api:8080
}
